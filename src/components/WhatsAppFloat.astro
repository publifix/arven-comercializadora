---
import WhatsAppGlyph from './WhatsAppGlyph.astro';
import { whatsappHref } from '../config/site';
---

<a
  href={whatsappHref}
  target="_blank"
  rel="noopener"
  data-wa-float
  class="bg-amarillo text-grafito hover:bg-amarillo-hover fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full shadow-[0_8px_24px_-6px_rgb(0_0_0/0.45)] transition-[background-color,transform,opacity,visibility] duration-300 [&.is-hidden]:invisible [&.is-hidden]:translate-y-4 [&.is-hidden]:opacity-0 hover:-translate-y-0.5 sm:right-6 sm:bottom-6 sm:size-16"
>
  <WhatsAppGlyph class="size-7 sm:size-8" />
  <span class="sr-only">Escribir por WhatsApp (se abre en una nueva pestaña)</span>
</a>

<script>
  // Se oculta mientras el hero o la sección de contacto están en pantalla, para no tapar contenido.
  const float = document.querySelector<HTMLElement>('[data-wa-float]');
  const zones = [document.querySelector('#hero-title')?.closest('section'), document.querySelector('#contacto')].filter(
    (el): el is HTMLElement => !!el,
  );
  if (float && zones.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    float.classList.add('is-hidden');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      float.classList.toggle('is-hidden', visible.size > 0);
    });
    zones.forEach((z) => io.observe(z));
  }
</script>
