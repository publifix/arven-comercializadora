---
import WhatsAppGlyph from './WhatsAppGlyph.astro';
import { whatsappHref } from '../config/site';
---

<a
  href={whatsappHref}
  target="_blank"
  rel="noopener"
  class="bg-amarillo text-grafito hover:bg-amarillo-hover fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full shadow-[0_8px_24px_-6px_rgb(0_0_0/0.45)] transition-[background-color,transform] duration-200 hover:-translate-y-0.5 sm:right-6 sm:bottom-6 sm:size-16"
>
  <WhatsAppGlyph class="size-7 sm:size-8" />
  <span class="sr-only">Escribir por WhatsApp (se abre en una nueva pestaña)</span>
</a>
