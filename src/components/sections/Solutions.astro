---
import SectionHeader from '../SectionHeader.astro';
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import uniformes from '../../assets/photos/arven-equipo-uniformes.png';
import { solutions } from '../../content/copy';
---

<section id="cadena-de-suministro" class="section-y bg-blanco" aria-labelledby="cadena-title">
  <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-20">
    <div class="lg:order-2">
      <SectionHeader id="cadena-title" eyebrow={solutions.eyebrow} title={solutions.title} intro={solutions.intro} />

      <ul class="border-gris-300 mt-10 border-t">
        {
          solutions.items.map((item) => (
            <li class="border-gris-300 grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 border-b py-6">
              <span class="icon-line text-grafito size-8 pt-0.5" aria-hidden="true">
                <Icon name={item.icon} class="size-8" />
              </span>
              <div>
                <h3 class="font-display text-grafito text-lg leading-snug font-semibold md:text-xl">{item.title}</h3>
                <p class="text-gris-700 mt-1.5 text-[0.9375rem] leading-[1.6] md:text-base">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <a href="#contacto" class="btn btn-primary mt-10 w-full sm:w-auto">
        {solutions.cta}
        <Icon name="ArrowRight" />
      </a>
    </div>

    <div class="lg:order-1">
      <div class="lg:sticky lg:top-28">
        <Photo
          src={uniformes}
          alt="Equipo de cinco colaboradores con uniforme industrial gris con reflejantes y cascos amarillos en una planta"
          sizes="(min-width: 80rem) 560px, (min-width: 64rem) 45vw, 100vw"
          class="aspect-[4/5] w-full object-cover sm:aspect-[16/10] lg:aspect-[4/5]"
          position="50% 40%"
        />
        <span class="lane mt-0 !h-1.5 !w-full" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
