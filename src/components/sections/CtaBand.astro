---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import WhatsAppGlyph from '../WhatsAppGlyph.astro';
import equipo from '../../assets/photos/arven-equipo-uniformes.png';
import { ctaBand } from '../../content/copy';
import { whatsappHref, telHref, site } from '../../config/site';
---

<section class="bg-grafito relative isolate overflow-hidden py-16 md:py-24" aria-labelledby="cta-title">
  <Photo src={equipo} alt="" sizes="100vw" pictureClass="absolute inset-0 -z-20" class="h-full w-full object-cover" position="50% 40%" />
  <!-- Overlay grafito al 85 % -->
  <div class="bg-grafito/85 absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end lg:gap-16">
    <div>
      <h2 id="cta-title" class="h2 text-amarillo max-w-[36rem]">{ctaBand.title}</h2>
      <p class="lead text-gris-100 mt-5 max-w-[34rem]">{ctaBand.text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
      <a href={whatsappHref} class="btn btn-primary" target="_blank" rel="noopener">
        <WhatsAppGlyph class="size-5" />
        {ctaBand.primary}
        <span class="sr-only">(se abre en una nueva pestaña)</span>
      </a>
      <a href={telHref} class="btn btn-outline-light">
        <Icon name="Phone" />
        {ctaBand.secondary}
        <span class="sr-only">: {site.contact.phoneDisplay}</span>
      </a>
    </div>
  </div>
</section>
