---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import WhatsAppGlyph from '../WhatsAppGlyph.astro';
import { contact } from '../../content/copy';
import { site, whatsappHref, telHref, mailHref, mapEmbedSrc, directionsHref } from '../../config/site';

const actions = [
  {
    kind: 'wa',
    label: 'WhatsApp',
    value: site.contact.whatsappDisplay,
    href: whatsappHref,
    external: true,
    srHint: 'se abre en una nueva pestaña',
    cls: 'bg-amarillo text-grafito hover:bg-amarillo-hover',
    sub: 'text-grafito/80',
    iconBox: 'bg-grafito text-amarillo',
  },
  {
    kind: 'tel',
    label: 'Teléfono',
    value: site.contact.phoneDisplay,
    href: telHref,
    external: false,
    srHint: '',
    cls: 'bg-grafito text-blanco hover:bg-negro',
    sub: 'text-gris-300',
    iconBox: 'bg-amarillo text-grafito',
  },
  {
    kind: 'mail',
    label: 'Correo',
    value: site.contact.email,
    href: mailHref,
    external: false,
    srHint: '',
    cls: 'bg-blanco text-grafito border-grafito hover:bg-gris-50 border-2',
    sub: 'text-gris-700',
    iconBox: 'bg-grafito text-amarillo',
  },
];
---

<section id="contacto" class="section-y bg-blanco" aria-labelledby="contacto-title">
  <div class="container-x grid gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <SectionHeader id="contacto-title" eyebrow={contact.eyebrow} title={contact.title} intro={contact.text} />

      <ul class="mt-10 grid gap-3">
        {
          actions.map((a) => (
            <li>
              <a
                href={a.href}
                class:list={['group flex min-h-24 items-center gap-5 px-5 py-4 transition-colors duration-200 sm:px-6', a.cls]}
                {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class:list={['flex size-14 shrink-0 items-center justify-center', a.iconBox]} aria-hidden="true">
                  {a.kind === 'wa' ? <WhatsAppGlyph class="size-7" /> : <Icon name={a.kind === 'tel' ? 'Phone' : 'Mail'} class="size-7" />}
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class:list={['font-display text-xs font-semibold tracking-[0.08em] uppercase sm:text-sm', a.sub]}>{a.label}</span>
                  <span class="font-display text-xl leading-tight font-bold sm:text-2xl">
                    {a.kind === 'mail' ? <Fragment>{a.value.split('@')[0]}@<wbr />{a.value.split('@')[1]}</Fragment> : a.value}
                  </span>
                  {a.srHint && <span class="sr-only">({a.srHint})</span>}
                </span>
                <Icon
                  name={a.external ? 'ArrowUpRight' : 'ArrowRight'}
                  class="size-6 shrink-0 transition-transform duration-200 group-hover:translate-x-1"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="lg:pt-2" aria-label="Ubicación y horario">
      <ul class="border-gris-100 divide-gris-100 divide-y border-y">
        <li class="flex gap-4 py-5">
          <Icon name="MapPin" class="text-grafito mt-0.5 size-6 shrink-0" />
          <div>
            <p class="font-display text-gris-700 text-xs font-semibold tracking-[0.08em] uppercase">Dirección</p>
            <p class="text-grafito mt-1 font-medium">{contact.address}</p>
          </div>
        </li>
        <li class="flex gap-4 py-5">
          <Icon name="Clock" class="text-grafito mt-0.5 size-6 shrink-0" />
          <div>
            <p class="font-display text-gris-700 text-xs font-semibold tracking-[0.08em] uppercase">Horario</p>
            <p class="text-grafito mt-1 font-medium">{contact.hours}</p>
          </div>
        </li>
      </ul>

      <!-- Mapa con carga diferida: el iframe de Google Maps solo se inserta cuando la sección se acerca a la vista -->
      <div class="bg-gris-100 relative mt-6 aspect-[4/3] w-full overflow-hidden" data-map data-src={mapEmbedSrc}>
        <svg class="text-gris-300 absolute inset-0 h-full w-full" aria-hidden="true">
          <defs>
            <pattern id="grid-map" width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M32 0H0v32" fill="none" stroke="currentColor" stroke-width="1"></path>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid-map)"></rect>
        </svg>
        <span class="bg-grafito text-amarillo absolute top-1/2 left-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center" aria-hidden="true">
          <Icon name="MapPin" class="size-7" />
        </span>
      </div>

      <a href={directionsHref} target="_blank" rel="noopener" class="btn btn-outline-dark mt-4 w-full sm:w-auto">
        <Icon name="Navigation" />
        {contact.directions}
        <span class="sr-only">(Google Maps, se abre en una nueva pestaña)</span>
      </a>
    </aside>
  </div>
</section>

<script>
  // Inserta el mapa de Google Maps solo cuando el contenedor está por entrar en pantalla.
  const map = document.querySelector<HTMLElement>('[data-map]');
  if (map) {
    const load = () => {
      if (map.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.src!;
      iframe.title = 'Mapa: ubicación de ARVEN Comercializadora en Santiago de Querétaro';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      map.append(iframe);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '300px 0px' },
      );
      io.observe(map);
    } else {
      load();
    }
  }
</script>
