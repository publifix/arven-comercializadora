---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import WhatsAppGlyph from '../WhatsAppGlyph.astro';
import { services } from '../../content/copy';
import { waLink } from '../../config/site';

const serviceLink = (title: string) => {
  const name = title.charAt(0).toLowerCase() + title.slice(1);
  return waLink(`Hola, me interesa el servicio de ${name}.`);
};
---

<section id="servicios" class="section-y bg-blanco" aria-labelledby="servicios-title">
  <div class="container-x">
    <SectionHeader id="servicios-title" eyebrow={services.eyebrow} title={services.title} intro={services.intro} />

    <ul class="border-grafito mt-12 grid border-t-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        services.items.map((item, i) => (
          <li
            class:list={[
              'border-gris-100 flex flex-col border-b py-8 sm:px-6 lg:border-b-0 lg:py-10',
              'sm:odd:border-r sm:odd:pl-0 sm:even:pr-0 lg:border-r lg:!px-7 lg:first:!pl-0 lg:last:border-r-0 lg:last:!pr-0',
              i >= 2 && 'sm:border-b-0',
            ]}
          >
            <span class="bg-amarillo text-grafito flex size-14 items-center justify-center" aria-hidden="true">
              <Icon name={item.icon} class="size-7" />
            </span>
            <h3 class="font-display text-grafito mt-6 text-xl leading-tight font-semibold md:text-[1.375rem]">
              <a href={item.href} class="hover:text-gris-700 decoration-amarillo decoration-2 underline-offset-4 hover:underline">{item.title}</a>
            </h3>
            <p class="text-gris-700 mt-3 flex-1 text-[0.9375rem] leading-[1.6] md:text-base">{item.text}</p>
            <a
              href={serviceLink(item.title)}
              target="_blank"
              rel="noopener"
              class="font-display text-grafito group mt-7 inline-flex min-h-11 items-center gap-2.5 self-start text-[0.9375rem] font-semibold tracking-[0.04em] uppercase"
            >
              <WhatsAppGlyph class="size-5" />
              <span class="decoration-amarillo underline decoration-2 underline-offset-[6px] group-hover:decoration-grafito">{services.cta}</span>
              <span class="sr-only">: {item.title} (se abre WhatsApp en una nueva pestaña)</span>
              <Icon name="ArrowUpRight" class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
