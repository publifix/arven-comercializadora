---
import type { ImageMetadata } from 'astro';
import SectionHeader from '../SectionHeader.astro';
import Photo from '../Photo.astro';
import automotriz from '../../assets/photos/industria-automotriz.png';
import aeroespacial from '../../assets/photos/industria-aeroespacial.png';
import alimentos from '../../assets/photos/industria-alimentos-bebidas.png';
import manufactura from '../../assets/photos/industria-manufactura-metalmecanica.png';
import logistica from '../../assets/photos/industria-logistica-almacenes.png';
import construccion from '../../assets/photos/industria-construccion-mantenimiento.png';
import corporativos from '../../assets/photos/industria-corporativos-oficinas.png';
import { industries } from '../../content/copy';

// Una fotografía por sector, en el mismo orden que industries.items.
const media: { src: ImageMetadata; pos: string; alt: string; wide?: boolean }[] = [
  { src: automotriz, pos: '60% 45%', alt: 'Operario con casco amarillo inspecciona carrocerías en una línea de ensamble automotriz con robots de soldadura', wide: true },
  { src: aeroespacial, pos: '30% 40%', alt: 'Técnico con guantes de nitrilo calibra los álabes de una turbina de avión' },
  { src: alimentos, pos: '45% 35%', alt: 'Operaria con cofia, cubrebocas y bata blanca revisa botellas en una línea de envasado' },
  { src: manufactura, pos: '45% 50%', alt: 'Fresadora CNC maquinando una pieza metálica con refrigerante' },
  { src: logistica, pos: '55% 50%', alt: 'Montacargas mueve una tarima en un almacén mientras un supervisor con chaleco dirige la carga en el andén' },
  { src: construccion, pos: '45% 35%', alt: 'Trabajador con casco y arnés de seguridad realiza mantenimiento a una estructura metálica en altura' },
  { src: corporativos, pos: '45% 40%', alt: 'Colaboradora trabaja en su computadora portátil en una oficina corporativa' },
];
------

<section id="industrias" class="section-y bg-blanco" aria-labelledby="industrias-title">
  <div class="container-x">
    <SectionHeader id="industrias-title" eyebrow={industries.eyebrow} title={industries.title} intro={industries.intro} />

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        industries.items.map((item, i) => {
          const m = media[i];
          return (
            <li
              class:list={[
                'group bg-grafito relative isolate flex min-h-[17rem] flex-col justify-end overflow-hidden lg:min-h-[20rem]',
                m.wide && 'sm:col-span-2',
              ]}
            >
              <Photo
                src={m.src}
                alt={m.alt}
                sizes={m.wide ? '(min-width: 64rem) 50vw, 100vw' : '(min-width: 64rem) 40vw, (min-width: 40rem) 75vw, 130vw'}
                widths={[480, 640, 800, 1024, 1280]}
                pictureClass="absolute inset-0 -z-20"
                class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
                position={m.pos}
              />
              <div
                class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(0_0_0/0.9)_0%,rgb(0_0_0/0.72)_42%,rgb(0_0_0/0.15)_100%)]"
                aria-hidden="true"
              />
              <div class="p-6">
                <h3 class="font-display text-blanco text-xl leading-tight font-semibold">{item.title}</h3>
                <p class="text-gris-100 mt-2 text-[0.9375rem] leading-[1.55]">{item.text}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
